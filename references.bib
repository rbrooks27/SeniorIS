  author  = {Wilson, Greg and Bryan, Jennifer and Cranston, Karen
             and Kitzes, Justin and Nederbragt, Lex and Teal, Tracy K.},
  title   = {Good Enough Practices in Scientific Computing},
  journal = {{PLOS Computational Biology}},
  year    = {2017},
